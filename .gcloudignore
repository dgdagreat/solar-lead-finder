# Controls what `gcloud run deploy --source .` uploads to Cloud Build.
#
# This file keeps the bundled ONNX classifier while excluding local reference
# imagery. Confirmed Google Maps scans must not be packaged as detector data.

.git/
.gitignore
.dockerignore
.gcloudignore

# Virtualenvs / caches
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Secrets & dev database (prod uses DATABASE_URL + a real SECRET_KEY)
.env
db.sqlite3

# Large / regenerable artifacts not needed at runtime
data/
notebooks/
staticfiles/
media/home_images/
media/annotated_*.jpg
media/models/*.pt
media/solar_references/
media/nosolar_references/
docs/screenshots/

# OS / editor noise
.DS_Store
*.sw[op]
.idea/
.vscode/
